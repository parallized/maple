{
  "name": "@maple/cli",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "bin": {
    "maple": "./dist/index.js",
    "maple-local": "./dist/standalone/maple-local.js"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "standalone": "bun scripts/standalone.ts",
    "build": "bun run build:hosted && bun run build:standalone",
    "build:hosted": "bun build src/index.ts --target bun --outfile dist/index.js --banner '#!/usr/bin/env bun'",
    "build:standalone": "bun scripts/build-standalone.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "lint": "echo \"lint not configured for @maple/cli\""
  },
  "dependencies": {
    "@maple/protocol": "workspace:*",
    "@maple/server": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "sharp": "^0.35.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0"
  }
}
